PORT=3000
# Owner account created on first start (if no owner exists yet). If OWNER_PASSWORD is unset, a random one is printed once.
OWNER_EMAIL=owner@autoreboot.in
OWNER_PASSWORD=
# Demo listings + demo user (demo@autoreboot.in / demo1234). Defaults to true in dev, false when NODE_ENV=production.
SEED_DEMO=true
# SQLite file location (default ./data/autoreboot.db)
# DATABASE_FILE=./data/autoreboot.db
# Set when running behind a reverse proxy that terminates HTTPS (so cookies get the Secure flag)
# TRUST_PROXY=true
