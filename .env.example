PORT=3000

# Owner account, created on first start if no owner exists yet.
# In production (NODE_ENV=production) OWNER_PASSWORD is REQUIRED (8+ characters).
OWNER_EMAIL=owner@autoreboot.in
OWNER_PASSWORD=

# Demo listings + demo user (demo@autoreboot.in / demo1234). Defaults to true in dev, false in production.
SEED_DEMO=true

# "Continue with Google" (optional). Create an OAuth client (type: Web application) in Google Cloud Console →
# APIs & Services → Credentials, add your site URL under "Authorized JavaScript origins", paste the Client ID here.
GOOGLE_CLIENT_ID=

# SQLite file. On Railway the attached volume is detected automatically (RAILWAY_VOLUME_MOUNT_PATH).
# DATABASE_FILE=./data/autoreboot.db
# Daily database snapshots (kept next to the database in ./backups). Set BACKUPS=false to turn off.
# BACKUP_KEEP=7

# Behind a reverse proxy that terminates HTTPS (Railway is detected automatically)
# TRUST_PROXY=true
